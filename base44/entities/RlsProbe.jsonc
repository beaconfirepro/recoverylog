{
  "name": "RlsProbe",
  "type": "object",
  "properties": {
    "surgery_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "data.surgery_id": {
        "$in": "{{user.data.surgery_access}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": []
}