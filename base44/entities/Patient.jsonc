{
  "name": "Patient",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Patient's full name. Shown masked on the claim screen."
    },
    "dob": {
      "type": "string",
      "format": "date",
      "description": "Patient's date of birth."
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the Base44 account that owns this patient record."
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}