{
  "name": "Surgery",
  "properties": {
    "mode": {
      "description": "Whether this row is a real surgery or the patient's maintenance record. A maintenance record has no surgery date and logs by calendar day; it sits in the record picker alongside any surgeries.",
      "enum": [
        "surgery",
        "maintenance"
      ],
      "default": "surgery",
      "type": "string"
    },
    "archived": {
      "default": false,
      "description": "Hidden from the picker but its days are kept.",
      "type": "boolean"
    },
    "fever_threshold": {
      "type": "number"
    },
    "goals": {
      "description": "Daily targets for the trackers that have one. A tracker with a goal draws its day-page pill as a bar: the number is that entry, the fill is the day's running total against the goal.",
      "properties": {
        "bodywork": {
          "description": "Minutes of body work a day, across MLD, tool work, other bodywork and the pump.",
          "type": "number"
        },
        "nutrients": {
          "description": "A target per nutrient, keyed by its name: Protein, Carbs, Fat, Fiber, Sugar, Sodium.",
          "type": "object"
        },
        "water": {
          "description": "Ounces of fluid a day.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "history_types": {
      "description": "Which tracked types are summarised on the History card for a day. A subset of tracked_types; empty or absent means none are singled out and the card shows its default counts.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "label": {
      "description": "Short name shown in the day-header picker, e.g. 'Tummy tuck' or 'Left knee'.",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "office_phone": {
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this surgery belongs to.",
      "type": "string"
    },
    "procedure": {
      "type": "string"
    },
    "surgeon": {
      "type": "string"
    },
    "surgery_date": {
      "description": "Day zero. Every day label counts from here. Blank on a maintenance record.",
      "format": "date",
      "type": "string"
    },
    "surgery_time": {
      "type": "string"
    },
    "track_after": {
      "default": true,
      "description": "Allow logging on the surgery date and after.",
      "type": "boolean"
    },
    "track_before": {
      "default": true,
      "description": "Allow logging on days before the surgery date.",
      "type": "boolean"
    },
    "tracked_types": {
      "description": "The arrangeable entry types offered for this surgery, in the order their buttons appear. Order is meaningful and is set by dragging the buttons. Does not include the pinned check-in. Empty or absent means all of them in the built-in order.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "patient_id",
    "label"
  ],
  "rls": {
    "create": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "delete": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    }
  },
  "type": "object"
}