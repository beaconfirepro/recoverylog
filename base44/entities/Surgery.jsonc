{
  "name": "Surgery",
  "properties": {
    "archived": {
      "default": false,
      "description": "Hidden from the picker but its days are kept.",
      "type": "boolean"
    },
    "checkin_measures": {
      "description": "Which measures the check-in records: pain, nausea, swelling, energy, mood, mobility. Empty or absent means all of them. A surgery can ask for fewer, never more.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checkin_slots": {
      "description": "How many times a day this surgery checks in, and when. Empty or absent means the built-in four.",
      "items": {
        "properties": {
          "label": {
            "description": "Chip shown on the check-in form, e.g. 'Waking'.",
            "type": "string"
          },
          "time": {
            "description": "When this check-in is due, HH:MM. Picks the slot for you when the form opens.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "fever_threshold": {
      "type": "number"
    },
    "goals": {
      "description": "Daily targets for the trackers that have one. A tracker with a goal draws its day-page pill as a bar: the number is that entry, the fill is the day's running total against the goal.",
      "properties": {
        "bodywork": {
          "description": "Minutes of body work a day, across MLD, tool work, other bodywork and the pump.",
          "type": "number"
        },
        "nutrients": {
          "description": "A target per nutrient, keyed by its name: Protein, Carbs, Fat, Fiber, Sugar, Sodium.",
          "type": "object"
        },
        "water": {
          "description": "Ounces of fluid a day.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "label": {
      "description": "Short name shown in the day-header picker, e.g. 'Tummy tuck' or 'Left knee'.",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "office_phone": {
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this surgery belongs to.",
      "type": "string"
    },
    "procedure": {
      "type": "string"
    },
    "surgeon": {
      "type": "string"
    },
    "surgery_date": {
      "description": "Day zero. Every day label counts from here.",
      "format": "date",
      "type": "string"
    },
    "surgery_time": {
      "type": "string"
    },
    "track_after": {
      "default": true,
      "description": "Allow logging on the surgery date and after.",
      "type": "boolean"
    },
    "track_before": {
      "default": true,
      "description": "Allow logging on days before the surgery date.",
      "type": "boolean"
    },
    "tracked_types": {
      "description": "The arrangeable entry types offered for this surgery, in the order their buttons appear. Order is meaningful and is set by dragging the buttons. Does not include the pinned check-in. Empty or absent means all of them in the built-in order.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "patient_id",
    "label"
  ],
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "create": {
      "data.patient_id": "{{user.data.patient_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  }
}