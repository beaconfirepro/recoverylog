{
  "name": "MedGroup",
  "properties": {
    "medicines": {
      "description": "The medicines this group offers. Picking the group on a Med entry brings all of these up already ticked; anything skipped is tapped off there.",
      "items": {
        "properties": {
          "dose": {
            "description": "How much is taken, e.g. '1 capsule'.",
            "type": "string"
          },
          "name": {
            "description": "Medicine name and strength, e.g. 'Gabapentin 300 mg'.",
            "type": "string"
          },
          "reason": {
            "description": "Why it is taken. Set up here, not asked again on every entry.",
            "type": "string"
          },
          "rxcui": {
            "description": "RxNorm concept id, when the medicine came from the drug lookup rather than being typed.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "description": "What the group is called on the Med tracker, e.g. 'AM Meds' or 'PRN Pain'.",
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this group belongs to.",
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "delete": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    }
  },
  "type": "object"
}