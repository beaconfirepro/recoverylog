{
  "name": "MeasurementSpot",
  "properties": {
    "name": {
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this spot belongs to.",
      "type": "string"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "delete": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    }
  },
  "type": "object"
}