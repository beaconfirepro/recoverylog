{
  "name": "RecoveryEntry",
  "properties": {
    "mode": {
      "description": "Denormalized from the owning record: 'surgery' or 'maintenance'. Lets views group by mode without a join. Matches the surgery this entry is filed under.",
      "enum": [
        "surgery",
        "maintenance"
      ],
      "default": "surgery",
      "type": "string"
    },
    "data": {
      "description": "Everything the entry type records, keyed by field. A check-in also stores a per-measure note under \"<measure>_note\", e.g. pain_note.",
      "type": "object"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "entry_time": {
      "type": "string"
    },
    "note": {
      "description": "A note about the whole entry.",
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this entry belongs to.",
      "type": "string"
    },
    "surgery_id": {
      "description": "Surgery this entry is being tracked against. A maintenance record is still a Surgery row, so this points at it.",
      "type": "string"
    },
    "type": {
      "enum": [
        "checkin",
        "water",
        "meals",
        "nutrients",
        "med",
        "temp",
        "rest",
        "movement",
        "bm",
        "urine",
        "drainage",
        "incisions",
        "compression",
        "skin",
        "mld",
        "tools",
        "bodywork",
        "pump",
        "vibration",
        "photo",
        "measure",
        "weight"
      ],
      "type": "string"
    }
  },
  "required": [
    "date",
    "type",
    "entry_time"
  ],
  "rls": {
    "create": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "delete": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    }
  },
  "type": "object"
}