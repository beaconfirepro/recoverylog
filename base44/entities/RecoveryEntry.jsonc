{
  "name": "RecoveryEntry",
  "properties": {
    "data": {
      "description": "Everything the entry type records, keyed by field. A check-in also stores a per-measure note under \"<measure>_note\", e.g. pain_note.",
      "type": "object"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "entry_time": {
      "type": "string"
    },
    "note": {
      "description": "A note about the whole entry.",
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this entry belongs to.",
      "type": "string"
    },
    "surgery_id": {
      "description": "Surgery this entry is being tracked against.",
      "type": "string"
    },
    "type": {
      "enum": [
        "checkin",
        "water",
        "food",
        "med",
        "temp",
        "urine",
        "bm",
        "pads",
        "incisions",
        "garment",
        "skin",
        "movement",
        "sleep",
        "mld",
        "tools",
        "bodywork",
        "vibration",
        "photo",
        "measure",
        "weight"
      ],
      "type": "string"
    }
  },
  "required": [
    "date",
    "type",
    "entry_time"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  }
}