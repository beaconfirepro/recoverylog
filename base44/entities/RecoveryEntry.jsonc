{
  "name": "RecoveryEntry",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Patient this entry belongs to."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "checkin",
        "water",
        "food",
        "med",
        "pain",
        "temp",
        "urine",
        "bm",
        "pads",
        "incisions",
        "garment",
        "skin",
        "walk",
        "movement",
        "sleep",
        "mld",
        "photo",
        "measure",
        "weight"
      ]
    },
    "entry_time": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "date",
    "type",
    "entry_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  }
}
