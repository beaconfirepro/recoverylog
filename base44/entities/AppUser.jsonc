{
  "name": "AppUser",
  "properties": {
    "can_write": {
      "default": true,
      "description": "False makes a team member read-only.",
      "type": "boolean"
    },
    "checkin_measures": {
      "description": "Which measures the check-in records: pain, nausea, swelling, energy, mood, mobility. Empty or absent means all of them. Belongs to the patient rather than a surgery: how often you are asked how you feel does not change because a second operation was added.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checkin_slots": {
      "description": "How many times a day this patient checks in, and when. Empty or absent means the built-in four.",
      "items": {
        "properties": {
          "label": {
            "description": "Chip shown on the check-in form, e.g. 'Waking'.",
            "type": "string"
          },
          "time": {
            "description": "When this check-in is due, HH:MM. Picks the slot for you when the form opens.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "claimed_at": {
      "description": "On a team_member row: when this person first confirmed the patient's name and date of birth and opened the log. Blank means the invite is still open.",
      "type": "string"
    },
    "dob": {
      "description": "This person's date of birth. Only meaningful on a patient row, where it is what a joining member types.",
      "format": "date",
      "type": "string"
    },
    "email": {
      "description": "Base44 login email. This is what links the row to a real signed-in account.",
      "type": "string"
    },
    "first_name": {
      "description": "This person's first name.",
      "type": "string"
    },
    "kind": {
      "description": "Whether this person is the patient or on their care team. Chosen once, when they first sign in.",
      "enum": [
        "patient",
        "team_member"
      ],
      "type": "string"
    },
    "last_name": {
      "description": "This person's last name.",
      "type": "string"
    },
    "match_dob": {
      "description": "On a team_member row: a copy of the patient's date of birth.",
      "format": "date",
      "type": "string"
    },
    "match_first_name": {
      "description": "On a team_member row: a copy of the patient's first name, written by the patient, matched when the member joins.",
      "type": "string"
    },
    "match_last_name": {
      "description": "On a team_member row: a copy of the patient's last name.",
      "type": "string"
    },
    "measurements": {
      "description": "Which spots this patient measures, in the order they want them on the form. Names from the built-in list, plus any of their own. Empty or absent means the built-in set.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "patient_id": {
      "description": "Which patient's group this row belongs to. A patient row points at itself.",
      "type": "string"
    }
  },
  "required": [
    "email",
    "kind"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "data.patient_id": "{{user.data.patient_id}}"
        },
        {
          "$and": [
            {
              "data.email": "{{user.email}}"
            },
            {
              "data.kind": "patient"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        },
        {
          "id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        }
      ]
    }
  }
}