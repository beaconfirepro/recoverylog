{
  "name": "SurgeryInfo",
  "properties": {
    "fever_threshold": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "office_phone": {
      "type": "string"
    },
    "patient_id": {
      "description": "Patient this surgery record belongs to.",
      "type": "string"
    },
    "procedure": {
      "type": "string"
    },
    "surgeon": {
      "type": "string"
    },
    "surgery_date": {
      "format": "date",
      "type": "string"
    },
    "surgery_time": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  },
  "type": "object"
}