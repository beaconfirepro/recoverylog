{
  "name": "RecoveryDay",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "Patient this day belongs to."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "day_number": {
      "type": "number"
    },
    "woke_at": {
      "type": "string"
    },
    "slept_hours": {
      "type": "number"
    },
    "slept_position": {
      "type": "string"
    },
    "red_flag_completed": {
      "type": "boolean"
    },
    "red_flag_answers": {
      "type": "object"
    },
    "red_flag_details": {
      "type": "object"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    }
  }
}
