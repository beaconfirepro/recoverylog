{
  "name": "RecoveryDay",
  "properties": {
    "mode": {
      "description": "Denormalized from the owning record: 'surgery' or 'maintenance'. A day row exists per (date, record), so a date with entries on two records has two day rows.",
      "enum": [
        "surgery",
        "maintenance"
      ],
      "default": "surgery",
      "type": "string"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "day_number": {
      "type": "number"
    },
    "patient_id": {
      "description": "Patient this day belongs to.",
      "type": "string"
    },
    "questions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "red_flag_answers": {
      "description": "yes or no per red-flag key.",
      "type": "object"
    },
    "red_flag_completed": {
      "type": "boolean"
    },
    "red_flag_details": {
      "description": "Per raised flag: the time, whether the office was called, and the note saying what happens next.",
      "type": "object"
    },
    "red_flag_sources": {
      "description": "Where each answer came from, keyed the same as red_flag_answers: \"auto\" if the day's own entries raised it and she left it standing, \"user\" if she answered it herself. Read on the day page to colour each flag.",
      "type": "object"
    },
    "slept_hours": {
      "type": "number"
    },
    "slept_position": {
      "type": "string"
    },
    "surgery_id": {
      "description": "Surgery this day is being tracked against. A maintenance record is still a Surgery row.",
      "type": "string"
    },
    "woke_at": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "delete": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.patient_id": "{{user.data.patient_id}}"
        }
      ]
    },
    "update": {
      "data.patient_id": "{{user.data.write_patient_id}}"
    }
  },
  "type": "object"
}